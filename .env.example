# OrbitWorks Multi-Channel AI Email Automation Engine — Environment Config

# Environment
ENVIRONMENT=development
APP_SECRET_KEY=change-this-to-a-secure-random-32-byte-string
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
PII_ENCRYPTION_KEY=super-secret-pii-key-exactly-32chars

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM Providers
OPENAI_API_KEY=sk-proj-your-openai-key
GROQ_API_KEY=gsk_your-groq-key
LLM_TIMEOUT_SECONDS=4.0

# Email Dispatch (Resend)
RESEND_API_KEY=re_your_resend_api_key
DEFAULT_SENDER_EMAIL=outreach@orbitworks.ai
UNSUBSCRIBE_BASE_URL=https://app.orbitworks.ai/api/v1/unsubscribe

# Meta Webhook — TWO SEPARATE VALUES (see comments)
# META_WEBHOOK_VERIFY_TOKEN: used ONLY in GET handshake (hub.verify_token)
# META_APP_SECRET:           used to verify POST payload X-Hub-Signature-256 (App Dashboard → Settings → Basic)
META_WEBHOOK_VERIFY_TOKEN=meta_verify_secret_token
META_APP_SECRET=your_meta_app_secret_from_dashboard_settings_basic

# Calendly
CALENDLY_WEBHOOK_SECRET=calendly_signing_secret_key
CALENDLY_SCHEDULING_URL=https://calendly.com/hello-orb-itworks/30min

# Google Ads
GOOGLE_ADS_LEAD_SECRET=google_ads_lead_secret_key

# LinkedIn Ads (X-LI-Signature HMAC verification)
LINKEDIN_ADS_SECRET=linkedin_lead_secret_key

# Website form webhook (X-Webhook-Signature HMAC verification)
WEBSITE_WEBHOOK_SECRET=website_webhook_secret_key

# GA4 Telemetry
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_measurement_api_secret

# Human-in-the-loop email approval gate (set true to require review before send)
REQUIRE_EMAIL_APPROVAL=false
